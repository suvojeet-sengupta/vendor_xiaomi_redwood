// Google WebView and Trichrome with 32 and 64 bit libraries, as stubs over the
// compressed APKs like on Pixels, so Play Store can update them. The module
// names match the APKs, so they live in their own namespace, which only
// webview.mk exports.

soong_namespace {
}

android_app_import {
    name: "TrichromeLibrary-Stub",
    owner: "google",
    apk: "proprietary/product/app/TrichromeLibrary-Stub/TrichromeLibrary-Stub.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "WebViewGoogle-Stub",
    owner: "google",
    apk: "proprietary/product/app/WebViewGoogle-Stub/WebViewGoogle-Stub.apk",
    overrides: [
        "webview",
        "WebViewGoogle64",
    ],
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}
